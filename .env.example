# =============================================================================
# MAI Help You 환경 변수 예시
#
# 이 파일을 env/.env.local(권장) 또는 프로젝트 루트 .env로 복사한 뒤 값을 채우세요.
#   - 두 파일이 모두 있으면 env/.env.local이 우선합니다.
#   - 이미 설정된 OS 환경 변수(예: docker compose의 environment)가 가장 우선합니다.
#   - Docker Compose는 컨테이너 설정으로 env/.env.local을 읽습니다.
# =============================================================================

# --- 공통 / Django ------------------------------------------------------------
# (필수) Django와 AI 서버가 함께 사용합니다. AI 서버는 이 값이 없으면 시작하지 않습니다.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (pgvector) ----------------------------------------------------
DATABASE_NAME=maple_chatbot_db
DATABASE_USER=postgres
# (필수) docker compose의 db 서비스도 이 값으로 생성됩니다.
DATABASE_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
# RAG 벡터 컬렉션 이름
COLLECTION_NAME=maplestory_documents_docs
# (선택) AI 서버의 DB 접속 문자열. 비우면 위 DATABASE_* 값으로 만듭니다.
# 예: postgresql+psycopg://postgres:비밀번호@127.0.0.1:5432/maple_chatbot_db
DB_CONNECTION=

# --- Redis ---------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- 넥슨 Open API --------------------------------------------------------------
# (필수) 넥슨 Open API(https://openapi.nexon.com)에서 발급한 키
NEXON_API_KEY=
# 서버 프로세스당 넥슨 API 초당 요청 수 상한 (개발 단계 키 기준 5, 서비스 단계 키로 바꾸면 올리세요)
NEXON_REQUESTS_PER_SECOND=5
# 넥슨 API 응답을 Redis에 캐싱해 Django와 AI 서버가 공유
NEXON_CACHE_ENABLED=True

# --- LLM -------------------------------------------------------------------------
# 질문 분류·검색어 재작성·캐릭터명 추출과 기본 답변 생성에 쓸 모델: gemini | deepseek
LLM_PROVIDER=deepseek
# 답변 생성만 다른 모델로 바꿀 때 (비우면 LLM_PROVIDER와 같음): gemini | deepseek | local
ANSWER_LLM_PROVIDER=deepseek
# LLM_PROVIDER=gemini일 때 필수
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# LLM_PROVIDER=deepseek일 때 필수 (https://platform.deepseek.com에서 발급)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# OpenAI 호환 Chat Completions API 주소
DEEPSEEK_API_BASE=https://api.deepseek.com
# 답변 생성의 사고 모드. 분류·추출은 항상 끔 (기본 False)
DEEPSEEK_THINKING_ENABLED=False
# ANSWER_LLM_PROVIDER=local일 때: OpenAI 호환 서버(vLLM 등) 주소와 모델 이름
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=merged_qwen

# --- 대화 -------------------------------------------------------------------------
# 프롬프트에 넣을 이전 대화 메시지 수 / 메시지당 최대 글자 수
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_HISTORY_MESSAGE_MAX_CHARS=2000
# Django가 호출할 AI 서버 주소 (docker compose 안에서는 http://fastapi:8001로 자동 설정)
AI_SERVER_URL=http://127.0.0.1:8001
# Django → AI 서버 내부 호출 토큰 (두 서버가 같은 값을 읽음). 로컬 개발에서는 비워도 됩니다.
AI_SERVER_TOKEN=
# AI 서버 관리자 API 토큰. 비우면 관리자 API를 막습니다.
AI_ADMIN_TOKEN=

# --- 채팅 남용 방지 ------------------------------------------------------------------
# 메시지 전송 횟수 제한 (1분/하루). 비로그인은 IP 기준
CHAT_RATE_LIMIT_USER=20/m,300/d
CHAT_RATE_LIMIT_ANON=5/m,30/d
CHAT_MESSAGE_MAX_CHARS=2000

# --- 모니터링 (선택) ---------------------------------------------------------------
LANGFUSE_ENABLED=False
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- 광고 (선택) -------------------------------------------------------------------
ADS_ENABLED=False
ADS_PROVIDER=mock
ADSENSE_CLIENT=
ADS_SLOT_LEADERBOARD=
ADS_SLOT_MEDIUM_RECT=
ADS_SLOT_SKYSCRAPER=

# --- RAG 지식 베이스 -----------------------------------------------------------------
# 검토 전(status: draft) 공략 문서도 적재할지 (개발용, 운영에서는 False)
RAG_INCLUDE_DRAFT_GUIDES=False
# 공지 종류(공지/업데이트/이벤트/캐시샵)별로 가져올 최신 공지 수
RAG_NOTICE_LIMIT=20
# 공략 문서·공지 정기 적재 주기(시간), 0이면 끔
RAG_SYNC_INTERVAL_HOURS=6
