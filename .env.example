# Django Settings
SECRET_KEY=your-django-secret-key-here

# API Keys
NEXON_API_KEY=your-nexon-api-key-here
HUGGINGFACE_TOKEN=your-huggingface-token-here
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Model Settings
LLM_PROVIDER=gemini  # gemini or local
MODEL_PATH=your-model-path-here
BASE_MODEL=Qwen/Qwen3-4B-Thinking-2507

# Development Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,django,fastapi,*

# Database Settings
DATABASE_USER=postgres
DATABASE_PASSWORD=your-db-password-here
DATABASE_NAME=maple_chatbot_db
DATABASE_HOST=db  # local: 127.0.0.1 / docker: db
DATABASE_PORT=5432

# DB Connection for pgvector (FastAPI AI server)
DB_CONNECTION=postgresql+psycopg://postgres:your-db-password-here@db:5432/maple_chatbot_db
COLLECTION_NAME=maplestory_documents_docs

# Redis Settings
REDIS_URL=redis://redis:6379/0  # local: redis://localhost:6379/0 / docker: redis://redis:6379/0

# AI Server URL
AI_SERVER_URL=http://fastapi:8001  # local: http://localhost:8001 / docker: http://fastapi:8001

# ==========================================
# Langfuse Configuration
# ==========================================
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_HOST=https://us.cloud.langfuse.com
