# Dockerfile.fastapi
# FastAPI AI 서버를 구동하기 위한 도커 파일입니다.

FROM python:3.11-slim

# 파이썬 출력 및 바이트코드 비활성화 설정
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# 시스템 종속성 설치 (PostgreSQL 드라이버 빌드에 필요)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 종속성 파일 복사 및 설치
# AI 서버는 GPU를 쓰지 않으므로(임베딩은 CPU, 답변 생성은 외부 LLM API) PyTorch를 CPU 전용 인덱스에서
# 먼저 설치합니다. 이렇게 하면 requirements.txt 설치 때 수 GB의 CUDA 라이브러리를 받지 않습니다.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0 && \
    pip install --no-cache-dir -r requirements.txt

# 소스코드 복사
COPY . .

# 포트 개방
EXPOSE 8001

# PYTHONPATH에 /app을 추가하여 모듈 절대경로 import 정상 작동 보장
ENV PYTHONPATH=/app

# uvicorn 실행 (0.0.0.0 바인딩)
CMD ["python", "-m", "ai_server.main"]
