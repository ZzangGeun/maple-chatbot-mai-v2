# =============================================================================
# MAI Help You 운영 환경 변수 예시 (docker-compose.prod.yml)
#
# 서버에서 env/.env.prod로 복사한 뒤 값을 채우세요. (env/ 폴더는 git에 올라가지 않습니다)
#   mkdir -p env && cp deploy/env.prod.example env/.env.prod
# 비밀 값 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- 도메인 -----------------------------------------------------------------------
# Caddy가 이 도메인으로 HTTPS 인증서를 발급받습니다. (DNS A 레코드가 서버 IP를 가리켜야 함)
# 로컬 점검은 DOMAIN=localhost (자체 서명 인증서)
DOMAIN=example.com
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# --- Django ----------------------------------------------------------------------
SECRET_KEY=change-me-long-random-string
# uvicorn 워커 수 (vCPU 수 정도)
WEB_CONCURRENCY=2
# HTTPS가 정상 동작하는 것을 확인한 뒤 31536000(1년)으로 올리세요.
SECURE_HSTS_SECONDS=0

# --- DB (db 컨테이너가 이 값으로 만들어집니다) ---------------------------------------
DATABASE_NAME=maple_chatbot_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-strong-password
DATABASE_PORT=5432
COLLECTION_NAME=maplestory_documents_docs

# --- 내부 인증 ---------------------------------------------------------------------
# Django → AI 서버 호출 토큰 (두 서버가 같은 파일을 읽으므로 한 번만 적으면 됩니다)
AI_SERVER_TOKEN=change-me-random
# AI 서버 관리자 API(지식 베이스 강제 적재) 토큰. 비우면 관리자 API를 막습니다.
AI_ADMIN_TOKEN=

# --- 넥슨 Open API -----------------------------------------------------------------
NEXON_API_KEY=
# 서비스 단계 키로 바꾸면 올리세요. (개발 단계 키는 5)
NEXON_REQUESTS_PER_SECOND=5
NEXON_CACHE_ENABLED=True

# --- LLM -------------------------------------------------------------------------
LLM_PROVIDER=deepseek
ANSWER_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_THINKING_ENABLED=False
GOOGLE_API_KEY=

# --- 채팅 남용 방지 ------------------------------------------------------------------
# 메시지 전송 횟수 제한 (1분/하루). 비로그인은 IP 기준
CHAT_RATE_LIMIT_USER=20/m,300/d
CHAT_RATE_LIMIT_ANON=5/m,30/d
CHAT_MESSAGE_MAX_CHARS=2000
CHAT_HISTORY_MAX_MESSAGES=10

# --- RAG 지식 베이스 -----------------------------------------------------------------
RAG_INCLUDE_DRAFT_GUIDES=False
RAG_NOTICE_LIMIT=20
RAG_SYNC_INTERVAL_HOURS=6

# --- 모니터링·광고 (선택) -------------------------------------------------------------
LANGFUSE_ENABLED=False
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ADS_ENABLED=False
ADS_PROVIDER=mock
ADSENSE_CLIENT=
ADS_SLOT_LEADERBOARD=
ADS_SLOT_MEDIUM_RECT=
ADS_SLOT_SKYSCRAPER=
